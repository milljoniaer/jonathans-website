#!/bin/sh

SUBFOLDER="${1:-}"

# Validate subfolder name if provided (only allow alphanumeric and hyphens)
if [ -n "$SUBFOLDER" ]; then
  case "$SUBFOLDER" in
    *[!a-zA-Z0-9-]*)
      echo "Error: SUBFOLDER contains invalid characters. Only alphanumeric and hyphens allowed."
      exit 1
      ;;
  esac
fi

cd dist || exit 3
find . -type d -exec chmod 755 {} \;
find . -type f -exec chmod 644 {} \;

if [ -n "$SUBFOLDER" ]; then
  # Preview deployment - sync to subfolder
  ssh website "mkdir -p jonathan/$SUBFOLDER"
  rsync -q --progress -avz --delete . website:jonathan/$SUBFOLDER/.
else
  # Production deployment - sync to root
  rsync -q --progress -avz --delete . website:jonathan/.
fi
